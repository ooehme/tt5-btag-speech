{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mdb/speech-video",
	"version": "2.0.5",
	"title": "Bundestag-Video",
	"category": "mdb-speeches",
	"icon": "video-alt3",
	"description": "Gibt das lokal gespeicherte Video der aktuellen Rede aus.",
	"textdomain": "mdb-bundestag-speeches",
	"editorScript": "mdb-speeches-editor",
	"editorStyle": "mdb-speeches-editor-style",
	"style": "mdb-speeches-style",
	"viewScript": "mdb-speeches-view",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"display": {
			"type": "string",
			"default": "click_to_load",
			"enum": [ "direct", "click_to_load", "link" ]
		},
		"controls": {
			"type": "boolean",
			"default": true
		},
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"muted": {
			"type": "boolean",
			"default": false
		},
		"aspectRatio": {
			"type": "string",
			"default": "16/9",
			"enum": [ "16/9", "4/3", "1/1", "21/9" ]
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": {
			"margin": true
		}
	}
}
