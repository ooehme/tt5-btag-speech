{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mdb/speech-source-link",
	"version": "2.0.2",
	"title": "Bundestag-Quellenlink",
	"category": "mdb-speeches",
	"icon": "external",
	"textdomain": "mdb-bundestag-speeches",
	"editorScript": "mdb-speeches-editor",
	"style": "mdb-speeches-style",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"label": {
			"type": "string",
			"default": "Originalquelle: Deutscher Bundestag"
		},
		"openInNewTab": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"typography": true,
		"color": {
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
